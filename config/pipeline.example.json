{
  "source_root": "D:/NetworkLessons/All-Courses-v3.0",
  "build_dir": "build",
  "notes_dir": "notes",
  "assets_dirname": "assets",
  "figure_min_width": 140,
  "figure_min_height": 90,
  "figure_min_area": 24000,
  "figure_render_zoom": 2.0,
  "extract_vector_figures": true,
  "vector_min_drawings": 6,
  "vector_min_cluster_drawings": 4,
  "vector_min_cluster_area": 12000,
  "vector_min_cluster_width_pt": 60.0,
  "vector_min_cluster_height_pt": 40.0,
  "vector_max_page_ratio": 0.55,
  "vector_max_long_text_lines": 3,
  "vector_area_per_extra_drawing": 40000.0,
  "vector_cluster_margin_pt": 16.0,
  "vector_label_gap_pt": 22.0,
  "vector_label_max_chars": 46,
  "vector_label_max_grow_pt": 70.0,
  "vector_clip_padding_pt": 10.0,
  "figure_dedupe": true,
  "caption_lookahead_pt": 90,
  "context_chars": 700,
  "figure_ocr": false,
  "ocr_lang": "eng",
  "clean_text_noise": true,
  "text_noise_lines": [
    "search …",
    "search ...",
    "search",
    "lessons",
    "lesson contents",
    "home",
    "forum",
    "members",
    "sign in",
    "sign up",
    "log in",
    "logout",
    "menu",
    "table of contents",
    "share this lesson",
    "about networklessons"
  ],
  "text_noise_patterns": [
    "^\\s*«",
    "»\\s*$",
    "^\\s*(page\\s+)?\\d+\\s*/\\s*\\d+\\s*$",
    "^\\s*©\\s*\\d{4}"
  ],
  "drop_toc_after_markers": [
    "lesson contents",
    "table of contents"
  ],
  "drop_toc_max_lines": 25,
  "chunk_chars": 12000,
  "task_include_full_text": true,
  "quote_match_threshold": 90,
  "visual_quote_threshold": 88,
  "coverage_min_ratio": 0.8,
