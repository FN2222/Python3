    "顺便一提",
    "在真实生产环境中通常",
    "补充一个课外",
    "超出本章"
  ],
  "token_whitelist": [
    "OSI",
    "TCP/IP",
    "CLI",
    "GUI",
    "ID",
    "IP",
    "MAC",
    "OK",
    "N/A",
    "Mermaid",
    "SVG",
    "PNG",
    "GIF",
    "MP4",
    "AI",
    "PDF",
    "Markdown",
    "L2",
    "L3",
    "IPv4",
    "IPv6",
    "Q",
    "A"
