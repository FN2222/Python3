  "min_sections": 3,
  "min_points_per_content_page": 2.0,
  "require_figure_when_available": true,
  "min_figure_reference_ratio": 0.6,
  "token_grounding": true,
  "forbidden_phrases": [
    "据说",
    "笔者认为",
    "我认为",
    "个人觉得",
    "可能是因为",
    "推测",
    "一般业界",
    "众所周知",
    "扩展阅读",
