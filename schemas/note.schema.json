{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "nlnotes 章节笔记结构 (note.json)",
  "description": "AI 只需产出符合本结构的 note.json;Markdown、图片、动画均由 nlnotes 确定性渲染。所有 page 字段必须是原文真实页码。",
  "type": "object",
  "additionalProperties": false,
  "required": ["pdf_id", "source_rel_path", "title_en", "title_zh", "summary_zh",
               "scope_zh", "sections", "key_takeaways_zh", "terms", "feynman"],
  "properties": {
    "pdf_id": {"type": "string", "minLength": 3},
    "source_rel_path": {"type": "string", "minLength": 1},
    "title_en": {"type": "string", "minLength": 1},
    "title_zh": {"type": "string", "minLength": 1},
    "summary_zh": {"type": "string", "minLength": 30,
                   "description": "3-5 句话说明本章讲什么、解决什么问题,只能来自原文"},
    "scope_zh": {"type": "string", "minLength": 10,
                 "description": "本章边界声明:明确写出本章覆盖与不覆盖的内容,防止发散"},
    "prerequisites_zh": {"type": "array", "items": {"type": "string"}, "default": []},

    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/section"}
    },

    "key_takeaways_zh": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 5}},

    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["en", "zh", "page"],
        "properties": {
          "en": {"type": "string", "minLength": 1},
          "zh": {"type": "string", "minLength": 1},
          "page": {"type": "integer", "minimum": 1},
          "note_zh": {"type": "string"}
        }
      }
    },

    "feynman": {"$ref": "#/definitions/feynman"},

    "meta": {
      "type": "object",
      "description": "可选:生成信息,不参与门禁",
      "additionalProperties": true
    }
  },

  "definitions": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "heading_zh", "heading_en", "pages", "points"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
        "heading_zh": {"type": "string", "minLength": 1},
        "heading_en": {"type": "string", "minLength": 1,
                       "description": "原文中对应的英文小节标题(若原文无标题,填该段落首句的关键短语)"},
        "pages": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "intro_zh": {"type": "string"},
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/point"}
        },
        "figures": {"type": "array", "items": {"$ref": "#/definitions/figureRef"}, "default": []},
        "visuals": {"type": "array", "items": {"$ref": "#/definitions/visual"}, "default": []},
        "configs": {"type": "array", "items": {"$ref": "#/definitions/configBlock"}, "default": []},
        "tables": {"type": "array", "items": {"$ref": "#/definitions/table"}, "default": []}
      }
    },

    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_zh", "text_en_quote", "page"],
      "properties": {
        "text_zh": {"type": "string", "minLength": 6,
                    "description": "中文讲解。必须是 text_en_quote 的忠实翻译/解释,不得添加原文没有的信息"},
        "text_en_quote": {"type": "string", "minLength": 12,
                          "description": "原文英文原句(逐字复制,可用 ... 省略中间部分)。verify 会做模糊比对"},
        "page": {"type": "integer", "minimum": 1},
        "kind": {"type": "string", "enum": ["fact", "definition", "mechanism", "step",
                                            "caveat", "example", "command"], "default": "fact"}
      }
    },

    "figureRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figure_id", "caption_zh", "explain_zh"],
      "properties": {
        "figure_id": {"type": "string", "pattern": "^fig-p\\d{3}-v?\\d+$",
                      "description": "必须来自 figures.json,不得自造"},
        "caption_zh": {"type": "string", "minLength": 2},
        "explain_zh": {"type": "string", "minLength": 10,
                       "description": "结合原文说明这张拓扑图在讲什么、各设备/链路的角色"},
        "callouts_zh": {"type": "array", "items": {"type": "string"}, "default": []},
        "labels_seen": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 40},
          "default": [],
          "description": "你在这张图里**实际看到**的文字标签(设备名 R1/SW1、接口名、网段 10.0.0.0/24 等),逐字照抄图上文字。拓扑图里的文字不在 PDF 文本层,登记在这里之后,笔记描述这张图时才不会被判为臆想。开启 figure_ocr 后会与 OCR 结果自动核对。"
        }
      }
    },

    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title_zh", "why_zh", "source_pages", "grounding", "spec"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
        "kind": {"type": "string",
                 "enum": ["mermaid", "graphviz", "packet_flow", "comparison_table", "ai_illustration"]},
        "title_zh": {"type": "string", "minLength": 2},
        "why_zh": {"type": "string", "minLength": 8,
                   "description": "为什么这里需要自制图:原文哪个点抽象/难懂"},
        "caption_zh": {"type": "string"},
        "source_pages": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "grounding": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 12},
          "description": "支撑本图每个元素的原文英文引用,verify 会逐条比对原文"
        },
        "spec": {"type": "object"}
      }
    },

    "configBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "page", "explain_zh"],
      "properties": {
        "code": {"type": "string", "minLength": 3,
                 "description": "逐字复制原文的配置/命令输出,不得改写或补全"},
        "lang": {"type": "string", "default": "text"},
        "page": {"type": "integer", "minimum": 1},
        "explain_zh": {"type": "string", "minLength": 6},
        "annotations_zh": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["line", "note_zh"],
            "properties": {
              "line": {"type": "string", "minLength": 1},
              "note_zh": {"type": "string", "minLength": 2}
            }
          },
          "default": []
        }
      }
    },

    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title_zh", "headers", "rows", "page"],
      "properties": {
        "title_zh": {"type": "string", "minLength": 1},
        "headers": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "rows": {"type": "array", "minItems": 1,
                 "items": {"type": "array", "items": {"type": "string"}}},
        "page": {"type": "integer", "minimum": 1}
      }
    },

    "feynman": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explain_back_zh", "questions"],
      "properties": {
        "explain_back_zh": {
          "type": "string", "minLength": 80,
          "description": "费曼第一步:用最朴素的中文把本章讲给外行听(不含术语堆砌),内容仍须来自原文"
        },
        "questions": {
          "type": "array", "minItems": 6,
          "items": {"$ref": "#/definitions/question"}
        },
        "blind_spots_zh": {
          "type": "array", "items": {"type": "string"},
          "description": "费曼第三步:本章中最容易卡住的点(必须来自原文内容)", "default": []
        },
        "review_plan_zh": {"type": "array", "items": {"type": "string"}, "default": []}
      }
    },

    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "difficulty", "q_zh", "q_en", "answer_zh", "answer_en",
                   "source_pages", "evidence_quote"],
      "properties": {
        "id": {"type": "string", "pattern": "^q\\d+$"},
        "type": {"type": "string",
                 "enum": ["concept", "process", "compare", "config", "troubleshoot", "calculation"]},
        "difficulty": {"type": "integer", "minimum": 1, "maximum": 3},
        "q_zh": {"type": "string", "minLength": 6},
        "q_en": {"type": "string", "minLength": 6},
        "answer_zh": {"type": "string", "minLength": 10},
        "answer_en": {"type": "string", "minLength": 10},
        "source_pages": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "evidence_quote": {"type": "string", "minLength": 12,
                           "description": "答案所依据的原文英文原句,verify 会比对"},
        "figure_refs": {"type": "array", "items": {"type": "string"}, "default": []},
        "scoring_points_zh": {"type": "array", "items": {"type": "string"}, "default": []}
      }
    }
  }
}
